# Copy this to .env and fill in values as needed.
# The Vite dev server proxies /api/mlb → https://statsapi.mlb.com/api/v1
# so no API key is required for the MLB Stats API (it's public).

# Override the MLB API base URL (optional — defaults to the proxy path)
# VITE_MLB_API_BASE_URL=/api/mlb

# ── Pipeline de datos (server/, scripts/db/, api/cron/) ──
# Los scripts locales leen .env.local (npm run db:*); se genera con
# `vercel env pull .env.local`. En Vercel, POSTGRES_URL y las variables
# SUPABASE_* las crea la integración de Supabase; CRON_SECRET protege el cron.
# POSTGRES_URL=postgres://usuario:password@host:6543/postgres?sslmode=require
# CRON_SECRET=una-cadena-larga-aleatoria
